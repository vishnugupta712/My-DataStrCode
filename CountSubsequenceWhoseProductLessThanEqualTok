import java.util.*;

class GfG {
  
   static int numOfSubsets(int[] arr, int k) {
        int n = arr.length;

        // Base case: if k is 0 or 1, no product of positive numbers < k
        if (k <= 1) return 0;

        // dp[i][j]: number of subsequences from first i elements with product ≤ j
        int[][] dp = new int[n + 1][k + 1];

        // Initialization:
        for (int i = 0; i <= n; i++) {
            dp[i][0] = 0;  // Product = 0 is not possible with positive integers
        }
     for (int i = 0; i <= k; i++) {
            dp[0][i] = 0;  // // no elements => no subsequences except empty
        }

        // DP filling
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= k; j++) {
                // Exclude current element
                dp[i][j] = dp[i - 1][j];

                // Include current element if it fits
                if (arr[i - 1] <= j) {
                    // Add all subsequences where product of previous elements ≤ j / arr[i-1]
                    dp[i][j] += dp[i - 1][j / arr[i - 1]] + 1; // +1 is for the element itself
                }
            }
        }

        return dp[n][k]; // final answer
    }

    public static void main(String[] args) {
        int[] arr = {1, 2, 3, 4};
        int k = 10;

        System.out.println(numOfSubsets(arr, k));
    }
}
